{
  "name": "entrance-desktop",
  "version": "0.1.7",
  "private": true,
  "description": "Electron shell locked to the local Entrance service.",
  "homepage": "https://github.com/EntranceToolBox/Entrance-Desktop",
  "author": {
    "name": "fcanlnony",
    "email": "fcanlnony@outlook.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EntranceToolBox/Entrance-Desktop.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "node launch-electron.js",
    "dev": "node launch-electron.js",
    "pack": "electron-builder --dir --publish never",
    "dist": "node package-app.js",
    "dist:darwin": "node package-app.js"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.entrance.desktop",
    "productName": "Entrance Desktop",
    "directories": {
      "output": "../../Desktop/dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "../../Share/Logo.png",
        "to": "Share/Logo.png"
      },
      {
        "from": "../../Entrance",
        "to": "Entrance",
        "filter": [
          "**/*",
          "!.git",
          "!**/.git/**",
          "!.gitignore",
          "!.dockerignore",
          "!**/.github/**",
          "!README.md",
          "!AGENTS.md",
          "!CLAUDE.md",
          "!Dockerfile",
          "!compose.yml",
          "!**/users.json",
          "!**/known_hosts.json",
          "!**/private-networks.json",
          "!**/.ssh_password_key",
          "!**/userdata/**",
          "!**/uploads/**",
          "!**/*.log"
        ]
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "../../Share/MacOS/entrance-desktop.png",
      "category": "public.app-category.utilities"
    }
  }
}
